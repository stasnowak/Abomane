---
import { actions } from 'astro:actions';
import CategoryBadge from '../../../components/CategoryBadge.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { getSubscription } from '../../../db/repo';
import Base from '../../../layouts/Base.astro';
import { addMonths, formatDate, formatDateShort, todayIso } from '../../../lib/dates';
import { formatEur } from '../../../lib/money';
import {
  cancelByDate,
  cycleLabel,
  nextBillingDate,
  normalizedMonthlyCents,
  occurrencesInRange,
} from '../../../lib/schedule';

const id = Number(Astro.params.id);
const subscription = Number.isInteger(id) ? getSubscription(id) : null;

if (!subscription) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const deleted = Astro.getActionResult(actions.subscription.remove);
if (deleted && !deleted.error) {
  return Astro.redirect('/abos');
}

const today = todayIso();
const next = nextBillingDate(subscription, today);
const monthly = Math.round(normalizedMonthlyCents(subscription));
const yearly = monthly * 12;
const deadline = cancelByDate(subscription, today);

// A five-year window is far enough to always contain the next five charges,
// even for a yearly subscription.
const upcoming = occurrencesInRange(subscription, today, addMonths(today, 60)).slice(0, 5);

const facts: Array<{ label: string; value: string }> = [
  { label: 'Amount per charge', value: formatEur(subscription.amountCents) },
  { label: 'Billing cycle', value: cycleLabel(subscription) },
  { label: 'First billing date', value: formatDate(subscription.firstBillingDate) },
  { label: 'Next charge', value: next ? formatDate(next) : 'None' },
];

if (subscription.cycle === 'recurring') {
  facts.push(
    { label: 'Cost per month', value: formatEur(monthly) },
    { label: 'Cost per year', value: formatEur(yearly) },
  );
}
if (subscription.endDate) {
  facts.push({ label: 'End date', value: formatDate(subscription.endDate) });
}
if (subscription.pausedAt) {
  facts.push({ label: 'Paused since', value: formatDate(subscription.pausedAt) });
}
if (subscription.noticePeriodCount && subscription.noticePeriodUnit) {
  const unit = subscription.noticePeriodUnit;
  const plural = subscription.noticePeriodCount === 1 ? unit : `${unit}s`;
  facts.push({ label: 'Notice period', value: `${subscription.noticePeriodCount} ${plural}` });
}
if (subscription.minTermCount) {
  facts.push({ label: 'Minimum term', value: `${subscription.minTermCount} months` });
}

const cardClass =
  'rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900';
const buttonClass =
  'rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium transition-colors hover:bg-slate-200/70 dark:border-slate-700 dark:hover:bg-slate-800';
---

<Base title={subscription.name} current="abos">
  <div class="mb-6">
    <a
      href="/abos"
      class="text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200"
      >← Back to all Abos</a
    >
    <div class="mt-2 flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">{subscription.name}</h1>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <StatusBadge status={subscription.status} />
          <CategoryBadge name={subscription.categoryName} color={subscription.categoryColor} />
          {
            subscription.tags.map((tag) => (
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                #{tag.name}
              </span>
            ))
          }
        </div>
      </div>
      <a
        href={`/abos/${subscription.id}/edit`}
        class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700"
        >Edit</a
      >
    </div>
  </div>

  {
    deadline && (
      <div
        class:list={[
          'mb-6 rounded-xl border p-4 text-sm',
          deadline.daysLeft <= 30
            ? 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-950/50 dark:text-amber-200'
            : 'border-slate-200 bg-slate-100/60 text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300',
        ]}
      >
        <p class="font-medium">
          Cancel by {formatDate(deadline.deadline)}
          {deadline.daysLeft >= 0 ? ` · ${deadline.daysLeft} days left` : ''}
        </p>
        <p class="mt-1 opacity-80">
          Give notice by then to avoid the renewal on {formatDate(deadline.renewal)}.
        </p>
      </div>
    )
  }

  <div class="grid gap-5 lg:grid-cols-3">
    <div class:list={[cardClass, 'lg:col-span-2']}>
      <h2 class="mb-4 text-sm font-semibold text-slate-500 uppercase dark:text-slate-500">
        Details
      </h2>
      <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
        {
          facts.map((fact) => (
            <div class="flex justify-between gap-3 border-b border-slate-100 pb-2 dark:border-slate-800">
              <dt class="text-sm text-slate-500 dark:text-slate-400">{fact.label}</dt>
              <dd class="tabular text-sm font-medium">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        subscription.url && (
          <p class="mt-4 text-sm">
            <a
              href={subscription.url}
              rel="noreferrer noopener"
              target="_blank"
              class="text-violet-600 hover:underline dark:text-violet-400"
            >
              {subscription.url}
            </a>
          </p>
        )
      }

      {
        subscription.notes && (
          <p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm whitespace-pre-line text-slate-600 dark:bg-slate-950/60 dark:text-slate-400">
            {subscription.notes}
          </p>
        )
      }
    </div>

    <div class={cardClass}>
      <h2 class="mb-4 text-sm font-semibold text-slate-500 uppercase dark:text-slate-500">
        Next charges
      </h2>
      {
        upcoming.length === 0 ? (
          <p class="text-sm text-slate-500 dark:text-slate-400">No further charges scheduled.</p>
        ) : (
          <ul class="flex flex-col gap-2">
            {upcoming.map((date) => (
              <li class="flex items-center justify-between text-sm">
                <span class="text-slate-600 dark:text-slate-400">{formatDateShort(date)}</span>
                <span class="tabular font-medium">{formatEur(subscription.amountCents)}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class:list={[cardClass, 'mt-5']}>
    <h2 class="mb-4 text-sm font-semibold text-slate-500 uppercase dark:text-slate-500">Actions</h2>
    <div class="flex flex-wrap items-center gap-2">
      {
        subscription.status !== 'active' && (
          <form method="POST" action={actions.subscription.setStatus}>
            <input type="hidden" name="id" value={subscription.id} />
            <input type="hidden" name="status" value="active" />
            <button type="submit" class={buttonClass}>
              Resume
            </button>
          </form>
        )
      }
      {
        subscription.status === 'active' && (
          <form method="POST" action={actions.subscription.setStatus}>
            <input type="hidden" name="id" value={subscription.id} />
            <input type="hidden" name="status" value="paused" />
            <button type="submit" class={buttonClass}>
              Pause
            </button>
          </form>
        )
      }
      {
        subscription.status !== 'cancelled' && (
          <form method="POST" action={actions.subscription.setStatus}>
            <input type="hidden" name="id" value={subscription.id} />
            <input type="hidden" name="status" value="cancelled" />
            <button type="submit" class={buttonClass}>
              Mark cancelled
            </button>
          </form>
        )
      }

      <form
        method="POST"
        action={actions.subscription.remove}
        data-confirm={`Delete ${subscription.name}? This cannot be undone.`}
        class="ml-auto"
      >
        <input type="hidden" name="id" value={subscription.id} />
        <button
          type="submit"
          class="rounded-lg border border-rose-300 px-3 py-1.5 text-sm font-medium text-rose-700 transition-colors hover:bg-rose-50 dark:border-rose-900 dark:text-rose-400 dark:hover:bg-rose-950/50"
        >
          Delete
        </button>
      </form>
    </div>
    <p class="mt-3 text-xs text-slate-500 dark:text-slate-500">
      Pausing stops the cost counting from today. Cancelling records today as the last charge date.
    </p>
  </div>
</Base>

<script>
  // Guard destructive submits. Without JavaScript the form still works, which is
  // the right trade-off for a single-user tool: no silent failures.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(form.dataset.confirm ?? 'Are you sure?')) event.preventDefault();
    });
  }
</script>
