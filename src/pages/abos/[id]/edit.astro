---
import { actions } from 'astro:actions';
import SubscriptionForm from '../../../components/SubscriptionForm.astro';
import { getSubscription, listCategories, listTags } from '../../../db/repo';
import Base from '../../../layouts/Base.astro';
import { formValuesFrom } from '../../../lib/view';

const id = Number(Astro.params.id);
const subscription = Number.isInteger(id) ? getSubscription(id) : null;

if (!subscription) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const result = Astro.getActionResult(actions.subscription.update);

if (result && !result.error && result.data.ok) {
  return Astro.redirect(`/abos/${result.data.id}`);
}

const failure = result && !result.error && !result.data.ok ? result.data : null;

const values = { ...formValuesFrom(subscription), ...(failure?.values ?? {}) };
const errors = failure?.fieldErrors ?? {};

const categories = listCategories();
const allTags = listTags();
---

<Base title={`Edit ${subscription.name}`} current="abos">
  <div class="mb-6">
    <a
      href={`/abos/${subscription.id}`}
      class="text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200"
      >← Back to {subscription.name}</a
    >
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Edit {subscription.name}</h1>
  </div>

  <div
    class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-800 dark:bg-slate-900"
  >
    <SubscriptionForm
      action={actions.subscription.update}
      values={values}
      errors={errors}
      categories={categories}
      allTags={allTags}
      submitLabel="Save changes"
      id={subscription.id}
      cancelHref={`/abos/${subscription.id}`}
    />
  </div>
</Base>
