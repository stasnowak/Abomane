---
import { actions } from 'astro:actions';
import { listCategories, listSubscriptions, listTags } from '../db/repo';
import Base from '../layouts/Base.astro';
import { COLOR_NAMES, swatch } from '../lib/colors';

const saved = Astro.getActionResult(actions.category.save);
const failure = saved && !saved.error && !saved.data.ok ? saved.data : null;
const errors = failure?.fieldErrors ?? {};
const values = failure?.values ?? {};

const categories = listCategories();
const tags = listTags();
const all = listSubscriptions({ status: 'all' });

const usageByCategory = new Map<number, number>();
for (const sub of all) {
  if (sub.categoryId === null) continue;
  usageByCategory.set(sub.categoryId, (usageByCategory.get(sub.categoryId) ?? 0) + 1);
}

const usageByTag = new Map<number, number>();
for (const sub of all) {
  for (const tag of sub.tags) {
    usageByTag.set(tag.id, (usageByTag.get(tag.id) ?? 0) + 1);
  }
}

const cardClass =
  'rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900';
const inputClass =
  'w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm outline-none focus:border-violet-500 dark:border-slate-700 dark:bg-slate-900';
---

<Base title="Settings" current="settings">
  <h1 class="mb-5 text-2xl font-semibold tracking-tight">Settings</h1>

  <div class="grid gap-5 lg:grid-cols-2">
    <div class={cardClass}>
      <h2 class="mb-1 font-semibold">Categories</h2>
      <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">
        Deleting a category keeps its subscriptions and just leaves them uncategorized.
      </p>

      <ul class="mb-5 flex flex-col divide-y divide-slate-100 dark:divide-slate-800">
        {
          categories.map((category) => (
            <li class="flex items-center justify-between gap-3 py-2">
              <span class="flex items-center gap-2">
                <span class:list={['h-3 w-3 rounded-full', swatch(category.color).dot]} />
                <span class="text-sm font-medium">{category.name}</span>
                <span class="text-xs text-slate-500 dark:text-slate-500">
                  {usageByCategory.get(category.id) ?? 0} in use
                </span>
              </span>
              <form
                method="POST"
                action={actions.category.remove}
                data-confirm={`Delete the category ${category.name}?`}
              >
                <input type="hidden" name="id" value={category.id} />
                <button
                  type="submit"
                  class="text-xs font-medium text-rose-600 hover:underline dark:text-rose-400"
                >
                  Delete
                </button>
              </form>
            </li>
          ))
        }
        {
          categories.length === 0 && (
            <li class="py-2 text-sm text-slate-500 dark:text-slate-400">No categories yet.</li>
          )
        }
      </ul>

      <form method="POST" action={actions.category.save} class="flex flex-col gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="category-name" class="text-sm font-medium">Add a category</label>
          <input
            id="category-name"
            name="name"
            type="text"
            required
            value={values.name ?? ''}
            placeholder="Streaming"
            class={inputClass}
          />
          {errors.name && <p class="text-xs text-rose-600 dark:text-rose-400">{errors.name}</p>}
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="category-color" class="text-sm font-medium">Colour</label>
          <select id="category-color" name="color" class={inputClass}>
            {
              COLOR_NAMES.map((name) => (
                <option value={name} selected={values.color === name}>
                  {name}
                </option>
              ))
            }
          </select>
        </div>

        <button
          type="submit"
          class="self-start rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700"
          >Add category</button
        >
      </form>
    </div>

    <div class={cardClass}>
      <h2 class="mb-1 font-semibold">Tags</h2>
      <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">
        Tags are created as you type them on a subscription. Unused ones are cleaned up
        automatically.
      </p>

      <ul class="flex flex-col divide-y divide-slate-100 dark:divide-slate-800">
        {
          tags.map((tag) => (
            <li class="flex items-center justify-between gap-3 py-2">
              <span class="text-sm">
                #{tag.name}
                <span class="ml-2 text-xs text-slate-500 dark:text-slate-500">
                  {usageByTag.get(tag.id) ?? 0} in use
                </span>
              </span>
              <form
                method="POST"
                action={actions.tag.remove}
                data-confirm={`Delete the tag ${tag.name}?`}
              >
                <input type="hidden" name="id" value={tag.id} />
                <button
                  type="submit"
                  class="text-xs font-medium text-rose-600 hover:underline dark:text-rose-400"
                >
                  Delete
                </button>
              </form>
            </li>
          ))
        }
        {
          tags.length === 0 && (
            <li class="py-2 text-sm text-slate-500 dark:text-slate-400">No tags yet.</li>
          )
        }
      </ul>
    </div>
  </div>

  <div class:list={[cardClass, 'mt-5']}>
    <h2 class="mb-1 font-semibold">About this instance</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      Abomane stores everything in one SQLite file and has no user accounts. Keep it on your own
      machine or behind a reverse proxy you trust, and back it up by copying the database file.
    </p>
  </div>
</Base>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(form.dataset.confirm ?? 'Are you sure?')) event.preventDefault();
    });
  }
</script>
