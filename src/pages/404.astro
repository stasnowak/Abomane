---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" current="">
  <div class="py-16 text-center">
    <p class="text-5xl font-semibold text-slate-300 dark:text-slate-700">404</p>
    <h1 class="mt-3 text-xl font-semibold">That page does not exist</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      The Abo may have been deleted, or the link may be wrong.
    </p>
    <a
      href="/abos"
      class="mt-6 inline-block rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700"
      >Back to all Abos</a
    >
  </div>
</Base>
