---
interface Props {
  label: string;
  name: string;
  error?: string | undefined;
  hint?: string | undefined;
  class?: string | undefined;
}
const { label, name, error, hint, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-1.5', className]}>
  <label for={name} class="text-sm font-medium text-slate-700 dark:text-slate-300">{label}</label>
  <slot />
  {hint && !error && <p class="text-xs text-slate-500 dark:text-slate-500">{hint}</p>}
  {error && <p class="text-xs font-medium text-rose-600 dark:text-rose-400">{error}</p>}
</div>
