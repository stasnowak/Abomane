---
import { swatch } from '../lib/colors';

interface Props {
  name: string | null;
  color: string | null;
}
const { name, color } = Astro.props;
const tone = swatch(color);
---

{
  name ? (
    <span class:list={['rounded-full px-2 py-0.5 text-xs font-medium', tone.badge]}>{name}</span>
  ) : (
    <span class="text-xs text-slate-400 dark:text-slate-600">—</span>
  )
}
